# Configuración de Producción
NODE_ENV=production
PORT=10000

# Base de Datos
DB_PATH=./server/database/cellfix.db

# CORS - Permitir todas las orígenes en producción
CORS_ORIGIN=*

# IVA
TAX_RATE=0.21

# Twilio para WhatsApp (opcional - completa con tus credenciales)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
