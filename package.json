{
  "name": "cellfix",
  "version": "1.0.0",
  "description": "Sistema de control de stock, ventas y presupuestos para CELLFIX",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "server:test": "jest --config server/jest.config.js",
    "client:test": "cd client && npm test"
  },
  "keywords": [
    "stock",
    "inventory",
    "ventas",
    "presupuestos"
  ],
  "author": "Ronicho123",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "pdfkit": "^0.13.0",
    "twilio": "^3.77.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "concurrently": "^7.4.0",
    "jest": "^29.3.1"
  }
}
